# TokenHarbor — nunca coloque uma chave real neste arquivo
TOKENHARBOR_API_KEY=cole_sua_chave_localmente
TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1
DEEPSEEK_MODEL=deepseek-v4.1-flash:free

# Banco de campanhas. Sem valor, usa SQLite em data/mj.sqlite3
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# Limite de taxa das rotas que chamam o MJ (por jogador, em memória por processo).
# Padrões: 30 mensagens por 60 segundos.
# MJ_LIMITE_REQUISICOES=30
# MJ_LIMITE_JANELA_SEGUNDOS=60
